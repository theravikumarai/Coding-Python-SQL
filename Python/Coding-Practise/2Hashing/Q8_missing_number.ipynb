    "def missing_number(nums):\n",
    "    seen = set(nums)\n",
    "    n = len(nums)\n",
    "    for i in range(n+1):\n",
    "        if i not in seen:\n",
    "            return i\n",
    "\n",
    "num = [0,1,3]\n",
    "print(missing_number(num))\n"
   ]
  },
